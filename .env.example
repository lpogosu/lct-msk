# «Взаимно» — переменные окружения. Скопируйте в .env и поменяйте секреты.
# Бэкенд читает только переменные с префиксом VZ_ (app/core/settings.py).
# Списки задаются через запятую. Значения ниже — умолчания для локальной разработки.
# Продуктовые веса, пороги и квоты здесь НЕ живут — они в config/*.yaml.

# ─── Общее ───────────────────────────────────────────────────────────────────
# dev | test | prod. В prod запрещены dev-секреты и обязательна Secure-cookie
VZ_ENV=dev
VZ_LOG_LEVEL=INFO
# Демо-режим: «+1 день» в демо-панели, автоответчики, ступенчатые демо-аккаунты
VZ_DEMO_MODE=false
# Каталог YAML-конфигов (по умолчанию <репозиторий>/config; в Docker — /app/config)
# VZ_CONFIG_DIR=/app/config

# ─── PostgreSQL (docker compose: сервис db) ──────────────────────────────────
VZ_DB_USER=vzaimno
VZ_DB_PASSWORD=vzaimno
VZ_DB_NAME=vzaimno
# Порт на хосте
VZ_DB_PORT=5432
# Строка подключения бэкенда при запуске вне Docker (в compose собирается из переменных выше)
VZ_DATABASE_URL=postgresql+psycopg://vzaimno:vzaimno@localhost:5432/vzaimno
VZ_DB_ECHO=false
VZ_DB_POOL_SIZE=10
VZ_DB_MAX_OVERFLOW=10
# Тесты: база-шаблон; для каждого запуска pytest создаётся отдельная база <имя>_<pid> и удаляется после
VZ_TEST_DATABASE_URL=postgresql+psycopg://vzaimno:vzaimno@localhost:5432/vzaimno_test

# ─── Адреса ──────────────────────────────────────────────────────────────────
# Адрес фронтенда — для ссылок в письмах (страница /verify-email)
VZ_PUBLIC_BASE_URL=http://localhost:5173
# Разрешённые источники CORS (через запятую)
VZ_CORS_ORIGINS=http://localhost:5173
VZ_BACKEND_PORT=8000

# ─── Секреты (ОБЯЗАТЕЛЬНО поменять в prod) ───────────────────────────────────
# В VZ_ENV=prod бэкенд не стартует с этими значениями и с секретами короче 32 символов
# (сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))")
# Подпись access-JWT (HS256)
VZ_JWT_SECRET=dev-insecure-jwt-secret-change-me
# HMAC кодов подтверждения email
VZ_APP_SECRET=dev-insecure-app-secret-change-me
# HMAC псевдонимов кандидатов «К-4821» (свой для каждой компании)
VZ_PSEUDONYM_SECRET=dev-insecure-pseudonym-secret-change-me

# ─── Сессии ──────────────────────────────────────────────────────────────────
VZ_JWT_ALGORITHM=HS256
VZ_JWT_ISSUER=vzaimno
# Access-токен: 15 минут
VZ_ACCESS_TOKEN_TTL_S=900
# Refresh-токен: 30 дней, ротация при каждом обновлении
VZ_REFRESH_TOKEN_TTL_S=2592000
# Повтор только что ротированного refresh в пределах окна — гонка вкладок (409), а не кража
VZ_REFRESH_REUSE_GRACE_S=10
VZ_REFRESH_COOKIE_NAME=vz_refresh
VZ_REFRESH_COOKIE_PATH=/api/auth
# true за HTTPS (обязательно в prod)
VZ_COOKIE_SECURE=false
# lax | strict | none (none требует Secure)
VZ_COOKIE_SAMESITE=lax
# VZ_COOKIE_DOMAIN=

# ─── Пароли (argon2id) ───────────────────────────────────────────────────────
VZ_PASSWORD_MIN_LENGTH=8
VZ_PASSWORD_MAX_LENGTH=128
VZ_ARGON2_TIME_COST=3
VZ_ARGON2_MEMORY_KIB=65536
VZ_ARGON2_PARALLELISM=4
# Не больше N хеширований одновременно (каждое ~64 МБ): иначе пачка входов выедает память контейнера
VZ_ARGON2_MAX_CONCURRENT=4

# ─── Коды из писем: подтверждение email и восстановление пароля ──────────────
# (лимиты считаются отдельно для каждой цели; почта демо-аккаунтов — домены вроде example.com или *.ru:
#  адреса в зонах .local/.test валидатор email отклоняет)
# Срок действия: 15 минут
VZ_EMAIL_CODE_TTL_S=900
# Повторная отправка — не раньше чем через 60 с
VZ_EMAIL_CODE_RESEND_COOLDOWN_S=60
# Не больше 5 писем в час
VZ_EMAIL_CODE_MAX_SENDS_PER_HOUR=5
# Неверных вводов на один код, потом код сгорает
VZ_EMAIL_CODE_MAX_ATTEMPTS=5

# ─── Ограничение частоты запросов: "N/секунд" (токен-корзина) ────────────────
VZ_RL_LOGIN_EMAIL=5/300
VZ_RL_LOGIN_IP=30/300
# Ввод кода на один email: подтверждение и (отдельная корзина) новый пароль по коду восстановления
VZ_RL_VERIFY_EMAIL=10/900
VZ_RL_REGISTER_IP=10/3600
# Повторная отправка кода и (отдельная корзина) запрос кода восстановления — с одного IP
VZ_RL_RESEND_IP=20/3600
VZ_RL_REFRESH_IP=60/60

# ─── Почта (в разработке — Mailpit: веб http://localhost:8025, SMTP :1025) ───
# smtp | console (console пишет письма в лог бэкенда)
VZ_MAIL_BACKEND=smtp
VZ_SMTP_HOST=localhost
VZ_SMTP_PORT=1025
# none | starttls | ssl
VZ_SMTP_SECURITY=none
# VZ_SMTP_USERNAME=
# VZ_SMTP_PASSWORD=
VZ_SMTP_TIMEOUT_S=10
VZ_MAIL_FROM=Взаимно <no-reply@vzaimno.local>
VZ_MAILPIT_UI_PORT=8025
VZ_MAILPIT_SMTP_PORT=1025

# ─── Продуктовые правила — НЕ здесь ──────────────────────────────────────────
# Личные почтовые домены (квота на аккаунт, пометка «личный email», DECISIONS п. 8) и лимит приглашений
# кандидата по умолчанию (3/5/10/∞) задаются в config/contact.yaml: quotas.personal_email_domains и
# candidate_limits.default_weekly — один список для регистрации и для квот.

# ─── ФСП ID (Keycloak, профиль compose «fsp») и реестр ФСП (fsp-mock) ────────
# Issuer, как его видит браузер
VZ_FSP_OIDC_ISSUER=http://localhost:8080/realms/fsp
# Тот же realm изнутри docker-сети (JWKS и обмен кода на токен); пусто — как VZ_FSP_OIDC_ISSUER
VZ_FSP_OIDC_INTERNAL_URL=http://keycloak:8080/realms/fsp
VZ_FSP_OIDC_CLIENT_ID=vzaimno
# Секрет конфиденциального client. Демо-realm (deploy/keycloak/realm-fsp.json): vzaimno-demo-secret; в prod — свой
VZ_FSP_OIDC_CLIENT_SECRET=vzaimno-demo-secret
VZ_FSP_OIDC_REDIRECT_URI=http://localhost:5173/auth/fsp/callback
# Scope запроса ФСП ID
# VZ_FSP_SCOPES=openid profile email
# Реестр достижений ФСП (мок)
VZ_FSP_REGISTRY_URL=http://localhost:8001
VZ_FSP_MOCK_PORT=8001
# http — только сеть; inprocess — встроенный снимок; auto — сеть, при недоступности снимок
VZ_FSP_PROVIDER=auto
# Статический bearer-токен мок-реестра (сервис fsp-mock принимает его же, FSP_MOCK_TOKENS)
VZ_FSP_REGISTRY_TOKEN=demo-fsp-registry-token
# Client credentials сервисного аккаунта: если задан, статический токен не используется
# VZ_FSP_TOKEN_URL=http://localhost:8080/realms/fsp/protocol/openid-connect/token
# VZ_FSP_REGISTRY_SCOPE=
# Таймаут запросов к реестру, секунд
# VZ_FSP_TIMEOUT_S=5
# Путь к снимку демо-реестра (по умолчанию app/fsp/data/demo_registry.json)
# VZ_FSP_SNAPSHOT_PATH=
# Кнопка «демо-вход ФСП» на случай, если Keycloak не поднят
VZ_FSP_DEMO_LOGIN_ENABLED=true
# Администратор Keycloak (только локально)
VZ_KEYCLOAK_ADMIN=admin
VZ_KEYCLOAK_ADMIN_PASSWORD=admin
VZ_KEYCLOAK_PORT=8080
# Домен для плейсхолдера redirect URI в realm-fsp.json (https://<домен>/auth/fsp/callback)
VZ_PUBLIC_DOMAIN=vzaimno.example
