{
  "realm": "fsp",
  "displayName": "ФСП ID (демо)",
  "displayNameHtml": "<b>ФСП ID</b> · демо-стенд",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru",
    "en"
  ],
  "defaultLocale": "ru",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "athlete",
        "description": "Спортсмен ФСП (демо)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "vzaimno",
      "name": "Взаимно — подбор ИТ-специалистов",
      "description": "Платформа «Взаимно»: вход через ФСП ID и чтение реестра достижений",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "vzaimno-demo-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": true,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "rootUrl": "http://localhost:8000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost/candidate/fsp/callback",
        "http://localhost:5173/candidate/fsp/callback",
        "http://localhost:8000/api/fsp/callback",
        "https://${VZ_PUBLIC_DOMAIN:vzaimno.example}/candidate/fsp/callback",
        "https://${VZ_PUBLIC_DOMAIN:vzaimno.example}/api/fsp/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8000/*##http://localhost/*##http://localhost:5173/*##https://${VZ_PUBLIC_DOMAIN:vzaimno.example}/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true"
      }
    }
  ],
