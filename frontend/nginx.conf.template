# nginx для «Взаимно»: статика Vite + SPA-fallback + прокси /api в бэкенд.
# Клиентский IP: X-Forwarded-For принимается только от доверенных прокси (VZ_REAL_IP_FROM; за Caddy в prod — подсеть compose),
# дальше заголовок для бэкенда ПЕРЕЗАПИСЫВАЕТСЯ адресом клиента ($remote_addr): иначе по подделанному заголовку обходились бы
# лимиты входа. Без прокси перед nginx (локальный стенд) доверять некому: 127.0.0.1.
set_real_ip_from ${VZ_REAL_IP_FROM};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_vary on;
gzip_proxied any;
gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml font/ttf;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # add_header в location отменяет унаследованные, поэтому заголовки безопасности подключаются в каждом location
    include /etc/nginx/security-headers.conf;
    # DNS docker: адрес бэкенда перерезолвится после его пересоздания, nginx не падает, если бэкенд ещё не поднят
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        include /etc/nginx/security-headers.conf;
        set $vz_upstream ${VZ_BACKEND_UPSTREAM};
        proxy_pass http://$vz_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        client_max_body_size 12m;
    }

    # Файлы с хешем в имени не меняются — кэш на год
    location ~ ^/(assets|fonts|3d)/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/csp.conf;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/csp.conf;
    }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/csp.conf;
        try_files $uri /index.html;
    }
}
